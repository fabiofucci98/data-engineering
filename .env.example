# Copy this file to `.env` and adjust values.
# `.env` is git-ignored — never commit it.

# Postgres (used by docker-compose.yml AND by the app scripts)
POSTGRES_DB=scientific_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
# Use 5433 if the machine already has a local Postgres on 5432
POSTGRES_PORT=5433

# pgAdmin (web UI at http://localhost:8080)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=8080

# Streamlit dashboard (http://localhost:8501)
STREAMLIT_PORT=8501

# City generator (simulated city) — its own Postgres container (localhost:5434)
CITY_POSTGRES_PORT=5434
#
# Host runs of the city generator point at that container with CITY_* overrides:
#   $env:CITY_POSTGRES_HOST="localhost"; $env:CITY_POSTGRES_PORT="5434"; $env:CITY_POSTGRES_DB="city"
#   python city-simulation/citygen/generate.py --seed 42
#
# pgAdmin (http://localhost:8080): register the two databases via the shared network:
#   sci-db :5432  /  city-db :5432  (user postgres / the password above)
# or via their published host ports 5433 / 5434.